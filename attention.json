---
layout: null
---
{
  "name": "拨弦记｜近期重要演出",
  "description": "《拨弦记》近期重要弹拨乐演出数据库",
  "updated": "{{ site.time | date: '%Y-%m-%d' }}",
  "events": [
{% for event in site.data.attention %}
    {
      "id": "{{ event.id | escape }}",
      "date": "{{ event.date }}",
      "city": "{{ event.city | escape }}",
      "title": "{{ event.title | escape }}",
      "performers": [
{% for performer in event.performers %}
        "{{ performer | escape }}"{% unless forloop.last %},{% endunless %}
{% endfor %}
      ],
      "instruments": [
{% for instrument in event.instruments %}
        "{{ instrument | escape }}"{% unless forloop.last %},{% endunless %}
{% endfor %}
      ],
      "link": "{{ event.link | escape }}"
    }{% unless forloop.last %},{% endunless %}
{% endfor %}
  ]
}