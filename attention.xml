---
layout: null
permalink: /attention.xml
---

<rss version="2.0">
  <channel>
    <title>拨弦记｜演出情报</title>
    <link>{{ site.url }}{{ site.baseurl }}/attention/</link>
    <description>《拨弦记》持续更新弹拨乐近期重要演出。</description>
    <language>zh-cn</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>拨弦记</generator>

{% assign events = site.data.attention | sort: "date" | reverse %}

{% for event in events %}
    <item>
      <title>{{ event.date }}｜{{ event.city }}｜{{ event.title | escape }}</title>
      <link>{{ event.link }}</link>
      <guid isPermaLink="true">{{ event.link }}</guid>
      <pubDate>{{ event.date | date: "%a, %d %b %Y 00:00:00 +0800" }}</pubDate>
      <description><![CDATA[
<strong>{{ event.title }}</strong><br>
📍 {{ event.city }}<br>
📅 {{ event.date }}<br><br>

<strong>查看演出详情：</strong><br>
<a href="{{ event.link }}">{{ event.link }}</a><br><br>

<strong>更多演出：</strong><br>
<a href="https://keenkwok.github.io/boxianji/attention/">拨弦记｜演出情报</a>
      ]]></description>
    </item>
{% endfor %}

  </channel>
</rss>